# Copy to docker-compose.env and adjust as needed.
# docker compose --env-file docker-compose.env up --build

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=palander

DATABASE_URL=postgresql://postgres:postgres@db:5432/palander
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=dev-compose-secret-change-me-32chars-min
JWT_EXPIRE_MINUTES=10080
